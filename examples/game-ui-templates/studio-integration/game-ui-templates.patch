+export interface GameUiReference {
+  readonly id: string; readonly kind: GameUiPresetKind; readonly game: string; readonly title: string;
+  readonly sourceUrl: string; readonly imageUrl: string;
+  readonly artStyle?: string; readonly layoutModel?: string;
+  readonly observed: readonly string[]; readonly layout: readonly string[];
