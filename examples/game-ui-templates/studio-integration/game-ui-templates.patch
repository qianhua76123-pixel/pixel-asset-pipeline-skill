+// @vitest-environment node
+import { describe, expect, it, vi } from "vitest";
+import { GAME_UI_PROMPT_PRESETS } from "../game-ui-prompt-presets";
+import { GAME_UI_REFERENCES, getGameUiReferences } from "../game-ui-references";
+import { GENERATION_PROMPT_TEMPLATES, applyGenerationPromptTemplate } from "../generation-prompt-templates";
+import { compilePixelGenerationPrompt, normalizePixelGenerationStandardOptions, DEFAULT_PIXEL_GENERATION_STANDARD } from "../pixel-generation-standard";
+import { createCreativeGeneration } from "../creative-workflows";
+import { validateGenerationInput } from "../providers";
+import { normalizeWorkflowRecipeDraft } from "../workflow-recipes";
+import { uiIconSheetAspectRatio } from "../ui-icon-sheet-aspect";
+
+const provider = { id: "image", name: "fixture", protocol: "openai" as const, model: "fixture", baseUrl: "http://localhost:1234/v1", enabled: true, hasKey: true };
+describe("researched game UI templates", () => {
+  it.each(GAME_UI_PROMPT_PRESETS.map(p => [p.id] as const))("lets the selected neutral background override the default transparent setting for %s", id => {
+    const spec = applyGenerationPromptTemplate(id, "界面").generationStandard;
+    const compiled = compilePixelGenerationPrompt("界面", { ...spec, background: "neutral" });
+    expect(compiled.standardSnapshot!.options.background).toBe("neutral");
+    expect(compiled.prompt).toContain("背景服从所选");
+    expect(compiled.prompt).not.toMatch(/界面外使用透明|上部留透明|长笺外侧透明/);
+  });
+
+  it.each(GAME_UI_PROMPT_PRESETS.map(p => [p.id] as const))("keeps custom content, UI rules and layout identity through request and recipe for %s", id => {
+    const network = vi.spyOn(globalThis, "fetch").mockRejectedValue(new Error("No generation during template use"));
+    try {
+      const preset = GAME_UI_PROMPT_PRESETS.find(p => p.id === id)!, prompt = "我自己的乡村UI，保留青绿色与米白；道具使用竹篮与茉莉。";
+      const patch = applyGenerationPromptTemplate(id, prompt);
+      expect(patch.prompt).toBe(prompt); expect(patch.generationStandard.uiPreset).toBe(id);
+      const compiled = compilePixelGenerationPrompt(patch.prompt, patch.generationStandard);
+      for (const rule of preset.promptRules) expect(compiled.prompt).toContain(rule);
+      expect(compiled.standardSnapshot!.options.uiPreset).toBe(id);
+      for (const note of [...preset.interactionNotes, ...preset.stateNotes]) expect(compiled.prompt).not.toContain(note);
+      const input = validateGenerationInput({ providerId: provider.id, prompt, generationStandard: patch.generationStandard });
+      expect(input.aspectRatio).toBe(preset.aspectRatio); expect(input.references).toEqual([]);
+      let nextId = 0;
+      const graph = createCreativeGeneration({ providerId: provider.id, templateId: id, prompt, automatic: true }, { providers: [provider], origin: { x: 0, y: 0 }, idFactory: () => `node-${++nextId}` });
+      expect(graph.nodes.map(n => n.data.role)).toEqual(["generation", "pixel", "cutout", "export"]);
+      const captured = normalizeWorkflowRecipeDraft({ version: 1, nodes: graph.nodes, edges: graph.edges });
+      expect(captured.nodes.find(n => n.data.role === "generation")!.data.generationStandard).toMatchObject({ uiPreset: id, logicalWidth: preset.width, logicalHeight: preset.height });
+      expect(network).not.toHaveBeenCalled();
+    } finally { network.mockRestore(); }
+  });
+  it("rejects unknown, mismatched and undersized full UI contracts before a provider request", () => {
+    const spec = applyGenerationPromptTemplate("game-ui-inventory-wood-paper", "背包").generationStandard;
+    for (const uiPreset of ["unknown", null, 1, {}, "__proto__"]) expect(() => normalizePixelGenerationStandardOptions({ ...spec, uiPreset })).toThrow("方案无效");
+    expect(() => normalizePixelGenerationStandardOptions({ ...spec, purpose: "ui-icon" })).toThrow("仅用于独立UI面板");
+    expect(() => normalizePixelGenerationStandardOptions({ ...spec, layout: "nine-slice" })).toThrow("不能混入");
+    expect(() => normalizePixelGenerationStandardOptions({ ...spec, logicalWidth: 128 })).toThrow("至少256px");
+    expect(() => validateGenerationInput({ providerId: provider.id, prompt: "背包", generationStandard: spec, aspectRatio: "1:1" })).toThrow("游戏界面请求比例");
+    expect(compilePixelGenerationPrompt("原始文本", { ...spec, enabled: false }).prompt).toBe("原始文本");
+    expect(normalizePixelGenerationStandardOptions(DEFAULT_PIXEL_GENERATION_STANDARD)).not.toHaveProperty("uiPreset");
+  });
+  it("provides twelve opt-in presets in four kinds without altering established defaults", () => {
+    expect(GENERATION_PROMPT_TEMPLATES.filter(t => t.standard.uiPreset)).toHaveLength(12);
+    expect(GENERATION_PROMPT_TEMPLATES).toHaveLength(76);
+    for (const kind of ["inventory", "shop", "dialogue", "crafting"] as const) {
+      expect(GAME_UI_PROMPT_PRESETS.filter(p => p.kind === kind)).toHaveLength(3);
+      const references = getGameUiReferences(kind);
+      expect(new Set(references.map(r => r.game)).size).toBeGreaterThanOrEqual(3);
+      for (const ref of references) {
+        expect(ref.sourceUrl).toMatch(/^https:\/\//); expect(ref.imageUrl).toMatch(/^https:\/\//);
+        expect(["documented", "inferred"]).toContain(ref.interactionEvidence.status);
+        expect(ref.observed.length).toBeGreaterThan(0); expect(ref.limits.length).toBeGreaterThan(0);
+      }
+    }
+    expect(GAME_UI_REFERENCES).toHaveLength(15);
+    const legacy = { ...DEFAULT_PIXEL_GENERATION_STANDARD };
+    expect(uiIconSheetAspectRatio(legacy)).toBeUndefined();
+  });
+});
