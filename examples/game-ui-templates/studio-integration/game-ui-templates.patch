+// @vitest-environment node
+import { describe, expect, it, vi } from "vitest";
+import { GAME_UI_COMMON_PROMPT_RULES, GAME_UI_PROMPT_PRESETS, getGameUiPromptPreset } from "../game-ui-prompt-presets";
+import { GENERATION_ASPECT_RATIOS } from "../generation-specs";
+
+describe("authored game UI artwork presets", () => {
+  it("covers each game task with three coherent material directions and unique identities", () => {
+    expect(GAME_UI_PROMPT_PRESETS).toHaveLength(12);
+    expect(new Set(GAME_UI_PROMPT_PRESETS.map(p => p.id)).size).toBe(12);
+    for (const kind of ["inventory", "shop", "dialogue", "crafting"]) {
+      const group = GAME_UI_PROMPT_PRESETS.filter(p => p.kind === kind);
+      expect(group).toHaveLength(3);
+      expect(group.map(p => p.style).sort()).toEqual(["cloth-grid", "ink-ledger", "wood-paper"]);
+      expect(new Set(group.map(p => p.promptRules.at(-1))).size).toBe(3);
+    }
+  });
+
+  it("uses exact supported API ratios rather than stretching a wide dialogue strip", () => {
+    for (const p of GAME_UI_PROMPT_PRESETS) {
+      expect(GENERATION_ASPECT_RATIOS).toContain(p.aspectRatio);
+      const [w, h] = p.aspectRatio.split(":").map(Number);
+      expect(p.width * h).toBe(p.height * w);
+      expect(p.width).toBeGreaterThanOrEqual(320); expect(p.height).toBeGreaterThanOrEqual(160);
+      expect(Number.isInteger(p.width)).toBe(true); expect(Number.isInteger(p.height)).toBe(true);
+    }
+    expect(GAME_UI_PROMPT_PRESETS.filter(p => p.kind === "dialogue").map(p => [p.width, p.height])).toEqual([[320, 160], [384, 256], [384, 192]]);
+  });
+
+  it("keeps image rules independent of a replaceable subject and runtime UX guidance", () => {
+    for (const p of GAME_UI_PROMPT_PRESETS) {
+      expect(p.promptRules.slice(0, GAME_UI_COMMON_PROMPT_RULES.length)).toEqual(GAME_UI_COMMON_PROMPT_RULES);
+      const brief = p.promptRules.join("\n");
+      expect(brief).toContain("正面平面投影"); expect(brief).toContain("精致像素色簇");
+      expect(brief).toContain("动态中文"); expect(brief).toContain("空白信息区"); expect(brief).toContain("不照抄商业游戏");
+      expect(brief).toContain("不是网页"); expect(brief).toContain("静态美术示意");
+      expect(p.interactionNotes.length).toBeGreaterThanOrEqual(3); expect(p.stateNotes.length).toBeGreaterThanOrEqual(3);
+      expect(p.referenceIds.length).toBeGreaterThanOrEqual(3);
+      // Interaction recommendations are not embedded as instructions to render
+      // text, focus navigation or a fabricated runnable interface in one bitmap.
+      for (const note of [...p.interactionNotes, ...p.stateNotes]) expect(brief).not.toContain(note);
+    }
+  });
+
+  it("provides different bounded layout diagrams for all variants without pretending they are artwork", () => {
+    for (const p of GAME_UI_PROMPT_PRESETS) {
+      expect(p.diagramRegions.length).toBeGreaterThanOrEqual(4); expect(p.diagramRegions.length).toBeLessThanOrEqual(6);
+      for (const region of p.diagramRegions) {
+        expect(region.label.trim()).not.toBe("");
+        expect(region.x).toBeGreaterThanOrEqual(0); expect(region.y).toBeGreaterThanOrEqual(0);
+        expect(region.width).toBeGreaterThan(0); expect(region.height).toBeGreaterThan(0);
+        expect(region.x + region.width).toBeLessThanOrEqual(1); expect(region.y + region.height).toBeLessThanOrEqual(1);
+        expect(Object.isFrozen(region)).toBe(true);
+      }
+      expect(Object.isFrozen(p.diagramRegions)).toBe(true);
+    }
+    for (const kind of ["inventory", "shop", "dialogue", "crafting"]) {
+      const diagrams = GAME_UI_PROMPT_PRESETS.filter(p => p.kind === kind).map(p => JSON.stringify(p.diagramRegions));
+      expect(new Set(diagrams).size).toBe(3);
+    }
+    expect(getGameUiPromptPreset("game-ui-dialogue-cloth-grid")!.diagramRegions.filter(r => r.label.startsWith("选择"))).toHaveLength(3);
+    expect(getGameUiPromptPreset("game-ui-shop-ink-ledger")!.diagramRegions[0].label).toBe("左页货目");
+  });
+
+  it("offers immutable, side-effect-free lookup without applying a template or calling an API", () => {
+    const network = vi.spyOn(globalThis, "fetch").mockRejectedValue(new Error("No network in a preset lookup"));
+    try {
+      const before = JSON.stringify(GAME_UI_PROMPT_PRESETS);
+      for (const p of GAME_UI_PROMPT_PRESETS) {
+        expect(getGameUiPromptPreset(p.id)).toBe(p);
+        expect(Object.isFrozen(p)).toBe(true);
+        for (const value of [p.promptRules, p.interactionNotes, p.stateNotes, p.referenceIds]) expect(Object.isFrozen(value)).toBe(true);
+      }
+      expect(Object.isFrozen(GAME_UI_PROMPT_PRESETS)).toBe(true);
+      expect(getGameUiPromptPreset("unknown")).toBeUndefined();
+      expect(JSON.stringify(GAME_UI_PROMPT_PRESETS)).toBe(before); expect(network).not.toHaveBeenCalled();
+    } finally { network.mockRestore(); }
+  });
+});
