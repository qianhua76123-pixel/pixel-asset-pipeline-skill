+  readonly transfer: readonly string[]; readonly limits: readonly string[];
+}
+/** Read-only study material; never becomes an asset, workflow input or provider reference. */
+export const GAME_UI_REFERENCES: readonly GameUiReference[] = Object.freeze(catalog.map(entry => Object.freeze(entry as GameUiReference)));
+export function getGameUiReferences(kind: GameUiPresetKind): readonly GameUiReference[] { return GAME_UI_REFERENCES.filter(entry => entry.kind === kind); }
