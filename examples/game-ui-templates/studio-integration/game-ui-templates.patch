+"use client";
+/* eslint-disable @next/next/no-img-element -- Preserve the complete remote research screenshot without creating a local asset. */
+
+import { useEffect, useId, useMemo, useRef, useState, type KeyboardEvent, type RefObject } from "react";
+import { ExternalLink, Images, X } from "lucide-react";
+import { getGameUiReferences, type GameUiReference } from "@/lib/pixel-studio/game-ui-references";
+import type { GameUiPresetKind } from "@/lib/pixel-studio/game-ui-prompt-presets";
+import shared from "./studio.module.css";
+import styles from "./GameUiReferenceBrowser.module.css";
+
+export interface GameUiReferenceBrowserProps { kind: GameUiPresetKind }
+const KIND_LABELS: Record<GameUiPresetKind, string> = { inventory: "背包", shop: "商店", dialogue: "对白", crafting: "制作" };
+
+function ResearchImage({ reference }: { reference: GameUiReference }) {
+  const [state, setState] = useState<"loading" | "ready" | "failed">("loading");
+  return <figure className={styles.figure}>
+    <div className={styles.imageStage} aria-busy={state === "loading"}>
+      {state === "loading" && <p className={styles.imageMessage} role="status">正在载入研究截图…</p>}
+      {state === "failed" ? <div className={styles.imageMessage} role="status"><p>研究截图暂时无法载入</p><a href={reference.sourceUrl} target="_blank" rel="noopener noreferrer">打开参考来源<ExternalLink size={13} aria-hidden="true" /></a></div>
+        : <img src={reference.imageUrl} alt={`研究参考：${reference.game} · ${reference.title}`} draggable={false} onLoad={() => setState("ready")} onError={() => setState("failed")} data-loaded={state === "ready"} />}
+    </div>
+    <figcaption><span>研究参考</span><span>非本项目成品</span></figcaption>
+  </figure>;
+}
+
+function Notes({ title, items }: { title: string; items: readonly string[] }) {
+  return <section className={styles.noteSection}><h3>{title}</h3>{items.length ? <ul>{items.map((item, index) => <li key={`${index}:${item}`}>{item}</li>)}</ul> : <p className={styles.muted}>暂无记录</p>}</section>;
+}
+
+function ResearchDialog({ kind, references, opener, onClose }: { kind: GameUiPresetKind; references: readonly GameUiReference[]; opener: RefObject<HTMLButtonElement | null>; onClose: () => void }) {
+  const id = useId(), dialogRef = useRef<HTMLDialogElement>(null), closeRef = useRef<HTMLButtonElement>(null);
+  const choices = useRef(new Map<string, HTMLButtonElement>());
+  const [selectedId, setSelectedId] = useState(references[0]?.id ?? "");
+  const selectedIndex = Math.max(0, references.findIndex(item => item.id === selectedId)), selected = references[selectedIndex];
+  useEffect(() => {
+    const dialog = dialogRef.current, focusTarget = opener.current;
+    dialog?.showModal(); closeRef.current?.focus();
+    return () => {
+      if (dialog?.open) dialog.close();
+      if (focusTarget?.isConnected && !focusTarget.disabled) focusTarget.focus();
+    };
+  }, [opener]);
+
+  function moveSelection(event: KeyboardEvent<HTMLButtonElement>, index: number) {
+    let next: number;
+    if (event.key === "ArrowDown" || event.key === "ArrowRight") next = (index + 1) % references.length;
+    else if (event.key === "ArrowUp" || event.key === "ArrowLeft") next = (index - 1 + references.length) % references.length;
+    else if (event.key === "Home") next = 0;
+    else if (event.key === "End") next = references.length - 1;
+    else return;
+    event.preventDefault(); event.stopPropagation();
+    const target = references[next];
+    if (target) { setSelectedId(target.id); choices.current.get(target.id)?.focus(); }
+  }
+
+  return <dialog ref={dialogRef} className={styles.dialog} aria-labelledby={`${id}-heading`} aria-describedby={`${id}-purpose`}
+    onCancel={event => { event.preventDefault(); event.stopPropagation(); onClose(); }}
+    onClose={event => {
+      event.stopPropagation();
+      // Strict Mode reopens after effect cleanup; its queued close event is stale.
+      if (!event.currentTarget.open) onClose();
+    }}
+    onKeyDown={event => { if (event.key === "Escape") { event.preventDefault(); event.stopPropagation(); onClose(); } }}>
+    <header className={styles.header}><div><h2 id={`${id}-heading`}>游戏 UI 参考</h2><p id={`${id}-purpose`}>{KIND_LABELS[kind]} · 研究参考</p></div><button ref={closeRef} type="button" className={shared.iconButton} aria-label="关闭游戏参考" onClick={onClose}><X size={18} aria-hidden="true" /></button></header>
+    {selected ? <div className={styles.body}>
+      <div className={styles.referenceList} role="radiogroup" aria-label={`${KIND_LABELS[kind]}研究截图`}>{references.map((item, index) => <button key={item.id} ref={element => { if (element) choices.current.set(item.id, element); else choices.current.delete(item.id); }} type="button" role="radio" aria-label={`${item.game} · ${item.title}`} aria-checked={item.id === selected.id} tabIndex={item.id === selected.id ? 0 : -1} className={styles.referenceChoice} onClick={() => setSelectedId(item.id)} onKeyDown={event => moveSelection(event, index)}><strong>{item.game}</strong><span>{item.title}</span></button>)}</div>
+      <article className={styles.article} aria-label={`${selected.game}参考分析`}>
+        <details className={styles.compareDisclosure}><summary>同类对比</summary><div className={styles.compareScroll}><table aria-label={`${KIND_LABELS[kind]}游戏UI同类对比`}><thead><tr><th scope="col">游戏</th><th scope="col">画风</th><th scope="col">布局</th><th scope="col">交互依据</th></tr></thead><tbody>{references.map(item => <tr key={item.id} data-selected={item.id === selected.id}><th scope="row"><button type="button" aria-label={`查看${item.game}参考`} aria-pressed={item.id === selected.id} onClick={() => setSelectedId(item.id)}>{item.game}</button></th><td>{item.artStyle ?? "未单独归类"}</td><td>{item.layoutModel ?? "查看下方布局分析"}</td><td>{item.interactionEvidence.status === "documented" ? "文档/截图" : "推演"}</td></tr>)}</tbody></table></div></details>
+        <h3 className={styles.referenceTitle}>{selected.game}<span>{selected.title}</span></h3>
+        <ResearchImage key={`${selected.id}:${selected.imageUrl}`} reference={selected} />
+        <div className={styles.notes}><Notes title="画风与可见元素" items={selected.observed} /><Notes title="布局" items={selected.layout} /></div>
+        <section className={styles.evidence} aria-label="交互证据"><h3>交互依据<span data-evidence={selected.interactionEvidence.status}>{selected.interactionEvidence.status === "documented" ? "文档或截图明示" : "推断，未验证"}</span></h3><p>{selected.interactionEvidence.description}</p></section>
+        <details className={styles.disclosure}><summary>来源、迁移建议与局限</summary><div className={styles.sourceLinks}><a href={selected.sourceUrl} target="_blank" rel="noopener noreferrer">原始参考来源<ExternalLink size={13} aria-hidden="true" /></a>{selected.interactionEvidence.sources.map((source, index) => <a key={`${index}:${source.url}`} href={source.url} target="_blank" rel="noopener noreferrer">{source.title}<ExternalLink size={13} aria-hidden="true" /></a>)}</div><Notes title="可借鉴的部分" items={selected.transfer} /><Notes title="证据与使用边界" items={selected.limits} /></details>
+      </article>
+    </div> : <div className={styles.empty} role="status"><Images size={28} aria-hidden="true" /><h3>暂无这类游戏参考</h3><p>可以返回模板，继续查看其他类型。</p><button type="button" className={shared.secondaryButton} onClick={onClose}>返回模板</button></div>}
+  </dialog>;
+}
+
+/** Browsing research never imports an asset, changes a template or submits a generation. */
+export function GameUiReferenceBrowser({ kind }: GameUiReferenceBrowserProps) {
+  const references = useMemo(() => getGameUiReferences(kind), [kind]), opener = useRef<HTMLButtonElement>(null);
+  const [open, setOpen] = useState(false);
+  return <><button ref={opener} type="button" className={shared.secondaryButton + " " + styles.trigger} aria-haspopup="dialog" aria-expanded={open} onClick={() => setOpen(true)}><Images size={14} aria-hidden="true" />游戏参考 · {references.length}款</button>{open && <ResearchDialog key={kind} kind={kind} references={references} opener={opener} onClose={() => setOpen(false)} />}</>;
+}
