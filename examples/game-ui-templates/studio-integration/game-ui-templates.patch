diff --git a/src/lib/pixel-studio/game-ui-prompt-presets.ts b/src/lib/pixel-studio/game-ui-prompt-presets.ts
new file mode 100644
index 0000000..0f688a6
--- /dev/null
+++ b/src/lib/pixel-studio/game-ui-prompt-presets.ts
@@ -0,0 +1,275 @@
+/** Authored game-UI artwork briefs, not executable interfaces or accessibility certification.
+ * Image rules travel with a structured preset selection. Runtime interaction and
+ * state notes are separate review guidance and must not be sent as image commands.
+ * Research references are documentation IDs, never implicit provider image inputs. */
+export type GameUiPresetKind = "inventory" | "shop" | "dialogue" | "crafting";
+export type GameUiPresetStyle = "wood-paper" | "cloth-grid" | "ink-ledger";
+export type GameUiPresetAspectRatio = "4:3" | "3:2" | "2:1";
+
+export interface GameUiDiagramRegion {
+  readonly label: string;
+  /** Normalized to the complete logical canvas, for labeled layout diagrams only. */
+  readonly x: number;
+  readonly y: number;
+  readonly width: number;
+  readonly height: number;
+}
+
+export interface GameUiPromptPreset {
+  readonly id: string;
+  readonly kind: GameUiPresetKind;
+  readonly style: GameUiPresetStyle;
+  readonly label: string;
+  readonly description: string;
+  readonly width: number;
+  readonly height: number;
+  readonly aspectRatio: GameUiPresetAspectRatio;
+  /** Default subject only; user wording may replace this while promptRules remain. */
+  readonly subject: string;
+  /** Persistent image-generation constraints, independent of the default subject. */
+  readonly promptRules: readonly string[];
+  /** UX guidance for a future implementation, not evidence that it works. */
+  readonly interactionNotes: readonly string[];
+  readonly stateNotes: readonly string[];
+  readonly referenceIds: readonly string[];
+  /** Abstract, labeled regions; never a generated or production-ready UI preview. */
+  readonly diagramRegions: readonly GameUiDiagramRegion[];
+}
+
+export const GAME_UI_COMMON_PROMPT_RULES: readonly string[] = Object.freeze([
+  "只生成一张游戏UI静态美术示意，采用正面平面投影与精致像素色簇；不是网页、工具后台或可运行界面，也不生成透视手机模型。",
