+"use client";
+import type { GameUiPromptPreset } from "@/lib/pixel-studio/game-ui-prompt-presets";
+/** Labeled specification diagram only. It is never exported as game artwork. */
+export function GameUiLayoutDiagram({ preset, thumbnail = false }: { preset: GameUiPromptPreset; thumbnail?: boolean }) {
+  const { width, height } = preset;
+  return <svg viewBox={`0 0 ${width} ${height}`} width="100%" height="100%" role={thumbnail ? undefined : "img"} aria-hidden={thumbnail || undefined} aria-label={thumbnail ? undefined : `${preset.label}布局示意，非生成成品`} shapeRendering="crispEdges">
+    <rect x={1} y={1} width={width - 2} height={height - 2} rx={2} fill="var(--background)" stroke="var(--separator)" strokeWidth={2} />
+    {preset.diagramRegions.map((region, index) => {
+      const x = Math.round(region.x * width), y = Math.round(region.y * height), w = Math.round(region.width * width), h = Math.round(region.height * height);
+      return <g key={region.label}>
+        <rect x={x} y={y} width={w} height={h} rx={1} fill={index === 0 ? "var(--selection)" : "var(--surface)"} stroke="var(--separator)" />
+        {!thumbnail && <text x={x + w / 2} y={y + h / 2} dominantBaseline="central" textAnchor="middle" fontSize={Math.min(10, Math.max(7, height / 22))} fill="var(--secondary)" style={{ fontFamily: "inherit" }}>{region.label}</text>}
+      </g>;
+    })}
+  </svg>;
+}
